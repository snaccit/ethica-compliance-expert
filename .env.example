# Kopieren nach .env.local und bei Bedarf anpassen. Ohne Datei läuft die App mit Ollama und qwen2.5:7b.

# --- Sprachmodell -------------------------------------------------------------
# ollama (Standard) | openai (jeder OpenAI-kompatible Server, z. B. LM Studio) | mock (ohne Modell)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434          # Ollama-Standard
# LLM_CONTEXT=16384                            # Kontextfenster für Ollama (Tokens)

# LM Studio oder anderer OpenAI-kompatibler Server:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b-instruct
# LLM_API_KEY=                                 # nur falls dein Server einen Schlüssel verlangt

# --- Sonstiges ----------------------------------------------------------------
# Schon beantwortete Fragen in der App sofort aus dem Zwischenspeicher zeigen (Standard: aus)
# ANSWER_CACHE=on
